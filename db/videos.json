                "text": "\u0939\u0947 \u0938\u0947\u0925, \u0906\u092a \u0915\u093f\u0938\u0940 \u0915\u094b \u0915\u094d\u092f\u093e \u0938\u0932\u093e\u0939 \u0926\u0947\u0902\u0917\u0947 \u091c\u094b \u090f\u0915 \u092e\u0936\u0940\u0928\u0940\u0915 \u092c\u0928\u0928\u093e \u091a\u093e\u0939\u0924\u093e \u0939\u0948? \u092e\u0948\u0902 \u0905\u0924\u094d\u092f\u0927\u093f\u0915 \u0938\u0932\u093e\u0939 \u0926\u0942\u0902\u0917\u093e \u0915\u093f \u0906\u092a \u0905\u092a\u0928\u0947 \u0915\u094d\u0937\u0947\u0924\u094d\u0930 \u092e\u0947\u0902 \u090f\u0915 \u0938\u094d\u0925\u093e\u0928\u0940\u092f \u0926\u0941\u0915\u093e\u0928 \u092a\u0930 \u091c\u093e\u090f\u0902 \u091c\u094b \u0911\u091f\u094b\u092e\u094b\u092c\u093e\u0907\u0932 \u0915\u093e\u092e \u0915\u0930\u0924\u093e \u0939\u0948 \u0914\u0930 \u0915\u0947\u0935\u0932 \u092e\u0942\u0932 \u092c\u093e\u0924\u0947\u0902 \u0938\u0940\u0916\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u090f\u0915 \u092a\u094d\u0930\u0936\u093f\u0915\u094d\u0937\u0941\u0924\u093e \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0915\u0930\u0947\u0902 \u0914\u0930 \u0915\u093e\u0930\u094b\u0902 \u092a\u0930 \u0915\u093e\u092e \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0947\u0902 \u0907\u0938\u0938\u0947 \u092a\u0939\u0932\u0947 \u0915\u093f \u0906\u092a \u0935\u093e\u0938\u094d\u0924\u0935 \u092e\u0947\u0902 \u0938\u094d\u0915\u0942\u0932 \u091c\u093e\u090f\u0902 \u0914\u0930 \u0909\u0928 \u0938\u092d\u0940 \u091a\u0940\u091c\u094b\u0902 \u0915\u094b \u0938\u0940\u0916\u0947\u0902 \u091c\u093f\u0928\u094d\u0939\u0947\u0902 \u0906\u092a\u0915\u094b \u0905\u092d\u0940 \u0938\u0940\u0916\u0928\u0947 \u0915\u0940 \u0906\u0935\u0936\u094d\u092f\u0915\u0924\u093e \u0928\u0939\u0940\u0902 \u0939\u0948\u0964",
